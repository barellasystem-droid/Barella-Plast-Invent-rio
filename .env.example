# Connection string do Postgres (Supabase). No painel do Supabase:
# Project Settings -> Database -> Connection string -> aba "Transaction"
# (pooler, porta 6543) -- necessário no serverless, que abre/fecha uma conexão
# por request e esgotaria o limite do Postgres direto.
DATABASE_URL=

# Valor longo e aleatório. Gerar com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Obrigatório quando NODE_ENV=production (o servidor recusa iniciar sem isso).
JWT_SECRET=

# Opcional: só necessário se outro domínio/app precisar chamar esta API.
# Aceita múltiplas origens separadas por vírgula.
ALLOWED_ORIGIN=

# Porta usada só no modo local/LAN (server/index.js). Ignorado na Vercel.
PORT=3000
